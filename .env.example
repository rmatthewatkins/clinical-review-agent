# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/readmissions
ANTHROPIC_API_KEY=sk-ant-...

# Optional — FHIR API source
# FHIR_TOKEN=

# Optional — MIMIC-III / MIMIC-IV BigQuery sources (`--mimic-bq` / `--mimic-iv-bq`)
# Requires `pip install -e ".[mimic]"` and gcloud ADC. The BQ project is the
# one billed for queries, NOT the dataset project (`physionet-data` is public).
# BQ_PROJECT_ID=mimic-exploration
# MIMIC_COHORT_SIZE=100
# MIMIC_COHORT_STRATEGY=readmit  # readmit | high-acuity | random

# Optional — server config
# CORS_ORIGINS=http://localhost:3000
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# Optional — Claude model
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_TOKENS=4096

# Optional — connection pool
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# Optional — logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Optional — rate limiting (reviews per minute)
# REVIEW_RATE_LIMIT=10
